[Unit]
Description=HFDirector station and broadcast controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/transmission/HFDirector
ExecStart=/usr/bin/python3 -m hf_director serve
Restart=on-failure
RestartSec=5
Environment=QSSTV_XMLRPC_URL=http://127.0.0.1:7362
Environment=HFDIRECTOR_HOST=172.16.10.200

[Install]
WantedBy=default.target
